# Modele de configuration locale.
# Copiez ce fichier en .env et remplissez les valeurs.
#
#   cp .env.example .env          # macOS / Linux
#   copy .env.example .env        # Windows
#
# .env est ignore par git : vos secrets n'y seront jamais commites.
# Pas de commentaire en fin de ligne : le # serait pris pour une valeur.


# ---------------------------------------------------------------------------
# Cle API Groq — secours d'extraction pour les reponses en wolof.
# Utilisee uniquement quand l'appariement lexical echoue.
# Sans cle, l'agent fonctionne : il relance simplement sa question.
# Creer une cle : https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=


# ---------------------------------------------------------------------------
# Jeton Hugging Face — optionnel.
# Necessaire uniquement pour telecharger un modele a acces restreint.
# Creer un jeton : https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
HF_TOKEN=


# ---------------------------------------------------------------------------
# Reconnaissance et synthese vocales.
#   1 = mode simule, aucun modele telecharge, demarrage instantane
#   0 = modeles reels, ~2 Go telecharges a la premiere utilisation
# ---------------------------------------------------------------------------
STT_SIMULE=1
TTS_SIMULE=1
